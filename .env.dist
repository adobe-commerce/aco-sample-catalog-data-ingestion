# AC_EUR_WEBSITE_CODE=europe
# Store-view code for the French locale (default: fr_fr). Create it in Admin under the
# Europe website; ingest:paas --locales=fr-FR writes localized text to this store view.
# AC_FR_STORE_VIEW_CODE=fr_fr
